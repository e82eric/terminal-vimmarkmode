<UserControl x:Class="Microsoft.Terminal.Control.AiPromptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Microsoft.Terminal.Control"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Top"
             d:DesignHeight="55"
             d:DesignWidth="285"
             Background="Black"
             Opacity="1"
             TabNavigation="Cycle"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ClearTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4" Padding="4,8" Background="{x:Bind BackgroundColor, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border BorderBrush="{x:Bind BorderColor, Mode=OneWay}" BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}" CornerRadius="4" Margin="0,12,0,8" Grid.Row="0" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FuzzySearchTextBox"
                        Style="{StaticResource ClearTextBoxStyle}"
                        IsSpellCheckEnabled="False"
                        KeyDown="_TextBoxKeyDown"
                        HorizontalAlignment="Stretch"
                        TextChanged="_TextBoxTextChanged"
                        Grid.Column="0"/>

                    <mux:ProgressRing x:Name="LoadingSpinner"
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        Margin="8,0,4,0"
                        IsActive="False"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="100,0,100,0" Background="{x:Bind BackgroundColor, Mode=OneWay}">
                <TextBlock
                    x:Name="VimSearchHeaderTextBlock"
                    Text="AI Prompt - Command Mode"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{x:Bind HeaderTextColor, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Padding="5,0" />
            </Border>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{x:Bind BorderColor, Mode=OneWay}" BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}" CornerRadius="4" Margin="0,0,0,8" Padding="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ScrollViewer x:Name="ResultScrollViewer" 
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollBarVisibility="Auto" 
                              MinHeight="50">
                    <TextBlock x:Name="ResultTextBlock"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{x:Bind HeaderTextColor, Mode=OneWay}"
                               FontFamily="Consolas"
                               Padding="8,4"
                               HorizontalAlignment="Stretch"
                               Text="AI response will appear here..." />
                </ScrollViewer>
                
                <Button x:Name="CopyButton"
                        Grid.Row="1"
                        Content="Copy"
                        HorizontalAlignment="Right"
                        Margin="4,4,8,4"
                        Padding="8,2"
                        FontSize="12"
                        Click="_CopyButtonClick"
                        Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
