<UserControl x:Class="Microsoft.Terminal.Control.SnippetSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Microsoft.Terminal.Control"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             d:DesignHeight="55"
             d:DesignWidth="285"
             Background="Black"
             Opacity="1"
             TabNavigation="Cycle"
             MinWidth="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ClearTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{x:Bind BackgroundColor, Mode=OneWay}" MaxHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{x:Bind BorderColor, Mode=OneWay}" BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}" CornerRadius="4" Grid.Row="0" Padding="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SearchBoxRow" Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border
                    x:Name="SearchBoxBorder"
                    Grid.Row="0"
                    Height="40"
                    BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
                    BorderThickness="0,0,0,1">
                    <TextBox
                        x:Name="SearchBox"
                        IsSpellCheckEnabled="False"
                        Foreground="{x:Bind TextColor, Mode=OneWay}"
                        Background="{x:Bind BackgroundColor, Mode=OneWay}"
                        BorderThickness="0"
                        Padding="8,6"
                        TextChanged="_TextBoxTextChanged"
                        KeyDown="_TextBoxKeyDown">
                        <TextBox.Resources>
                            <StaticResource x:Key="TextControlBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <ListView
                    x:Name="ListBox"
                    Grid.Row="1"
                    Background="{x:Bind BackgroundColor, Mode=OneWay}"
                    VerticalAlignment="Stretch">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="{x:Bind SelectedItemColor, Mode=OneWay}" />
                    </ListView.Resources>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                </ListView>
            </Grid>
        </Border>
        <TextBlock
            Padding="10"
            x:Name="NoItemsPlaceholder"
            Text="No items found"
            Foreground="{x:Bind TextColor, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            FontSize="24"
            Opacity="0.6" />
    </Grid>
</UserControl>
