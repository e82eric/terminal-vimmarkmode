<UserControl x:Class="Microsoft.Terminal.Control.StreamingSuggestionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Microsoft.Terminal.Control"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="55"
             d:DesignWidth="285"
             Opacity="1"
             TabNavigation="Cycle"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ClearTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
        Height="264"
        MaxHeight="264"
        Background="{x:Bind BackgroundColor, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{x:Bind BorderColor, Mode=OneWay}" BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}" Background="{x:Bind BackgroundColor, Mode=OneWay}" CornerRadius="4" Margin="8,8,8,10" >
            <Grid x:Name="InnerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="InnerRow0" Height="Auto"/>
                    <RowDefinition x:Name="InnerRow1" Height="*"/>
                </Grid.RowDefinitions>
                <Border
                    x:Name="SearchBoxBorder"
                    Grid.Row="0"
                    Height="44"
                    BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            x:Name="SearchBox"
                            IsSpellCheckEnabled="False"
                            FontSize="15"
                            Foreground="{x:Bind TextColor, Mode=OneWay}"
                            Background="{x:Bind BackgroundColor, Mode=OneWay}"
                            BorderThickness="0"
                            Padding="8,6"
                            TextChanged="_SearchBoxTextChanged"
                            PreviewKeyDown="_SearchBoxKeyDown">
                            <TextBox.Resources>
                                <StaticResource x:Key="TextControlBackground" ResourceKey="SystemControlTransparentBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SystemControlTransparentBrush" />
                                <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                                <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                                <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
                            </TextBox.Resources>
                        </TextBox>
                        <mux:ProgressRing
                            Grid.Column="1"
                            x:Name="LoadingSpinner"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Width="14"
                            Height="14"
                            IsActive="False"
                            Visibility="Collapsed"/>
                        <Border
                            Grid.Column="2"
                            x:Name="ModeIndicatorBorder"
                            VerticalAlignment="Center"
                            Margin="4,0,8,0"
                            Padding="6,2"
                            Visibility="Collapsed"
                            CornerRadius="3"
                            BorderBrush="{x:Bind TextColor, Mode=OneWay}"
                            BorderThickness="1">
                            <TextBlock
                                x:Name="ModeIndicatorText"
                                Text="Fuzzy"
                                FontSize="12"
                                Foreground="{x:Bind TextColor, Mode=OneWay}"
                                Opacity="0.8"/>
                        </Border>
                    </Grid>
                </Border>
                <ListView
                    x:Name="ListBox"
                    Grid.Row="1"
                    Height="196"
                    Background="{x:Bind BackgroundColor, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    DataContext="{x:Bind}" >
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="{x:Bind SelectedItemColor, Mode=OneWay}" />
                    </ListView.Resources>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SuggestionSearchRow">
                            <StackPanel
                                Orientation="Vertical"
                                HorizontalAlignment="Left"
                                Padding="8,4">
                                <local:FuzzySearchTextControl
                                    FontSize="15"
                                    TextColor="{x:Bind TextColor}"
                                    HighlightedTextColor="{x:Bind HighlightedTextColor}"
                                    Text="{x:Bind Line}"
                                    HorizontalAlignment="Left"/>
                                <local:FuzzySearchTextControl
                                    FontSize="15"
                                    TextColor="{x:Bind TextColor}"
                                    HighlightedTextColor="{x:Bind HighlightedTextColor}"
                                    Text="{x:Bind SecondaryLine}"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind SecondaryVisibility}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="1"
                    Padding="10"
                    x:Name="NoItemsPlaceholder"
                    Text="No items found"
                    FontSize="15"
                    Foreground="{x:Bind TextColor, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Opacity="0.6"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>
        <Border
            x:Name="SplitOverlay"
            BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
            BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}"
            Background="{x:Bind BackgroundColor, Mode=OneWay}"
            CornerRadius="4"
            Margin="8,8,8,10"
            Visibility="Collapsed">
            <Grid x:Name="SplitInnerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SplitInnerRow0" Height="Auto"/>
                    <RowDefinition x:Name="SplitInnerRow1" Height="*"/>
                </Grid.RowDefinitions>
                <Border
                    x:Name="SplitSearchBoxBorder"
                    Grid.Row="0"
                    Height="44"
                    BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
                    BorderThickness="0,0,0,1">
                    <TextBox
                        x:Name="SplitSearchBox"
                        IsSpellCheckEnabled="False"
                        FontSize="15"
                        Foreground="{x:Bind TextColor, Mode=OneWay}"
                        Background="{x:Bind BackgroundColor, Mode=OneWay}"
                        BorderThickness="0"
                        Padding="8,6"
                        TextChanged="_SplitSearchBoxTextChanged"
                        PreviewKeyDown="_SearchBoxKeyDown">
                        <TextBox.Resources>
                            <StaticResource x:Key="TextControlBackground" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush" />
                            <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemControlTransparentBrush" />
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                <ListView
                    x:Name="SplitListBox"
                    Grid.Row="1"
                    Height="196"
                    Background="{x:Bind BackgroundColor, Mode=OneWay}"
                    VerticalAlignment="Stretch"
                    DataContext="{x:Bind}" >
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="{x:Bind SelectedItemColor, Mode=OneWay}" />
                    </ListView.Resources>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SuggestionSearchRow">
                            <StackPanel
                                Orientation="Vertical"
                                HorizontalAlignment="Left"
                                Padding="8,4">
                                <local:FuzzySearchTextControl
                                    FontSize="15"
                                    TextColor="{x:Bind TextColor}"
                                    HighlightedTextColor="{x:Bind HighlightedTextColor}"
                                    Text="{x:Bind Line}"
                                    HorizontalAlignment="Left"/>
                                <local:FuzzySearchTextControl
                                    FontSize="15"
                                    TextColor="{x:Bind TextColor}"
                                    HighlightedTextColor="{x:Bind HighlightedTextColor}"
                                    Text="{x:Bind SecondaryLine}"
                                    HorizontalAlignment="Left"
                                    Visibility="{x:Bind SecondaryVisibility}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="1"
                    Padding="10"
                    x:Name="SplitNoItemsPlaceholder"
                    Text="No items found"
                    FontSize="15"
                    Foreground="{x:Bind TextColor, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Opacity="0.6"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            Padding="10"
            BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
            BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}"
            Background="{x:Bind BackgroundColor, Mode=OneWay}"
            CornerRadius="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Name="copyNotificationContainer"
            Visibility="Collapsed">
            <TextBlock x:Name="copyNotificationText"></TextBlock>
        </Border>
        <Border
            x:Name="helpOverlay"
            Padding="12"
            BorderBrush="{x:Bind BorderColor, Mode=OneWay}"
            BorderThickness="{x:Bind InnerBorderThickness, Mode=OneWay}"
            Background="{x:Bind BackgroundColor, Mode=OneWay}"
            CornerRadius="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="Collapsed">
            <ScrollViewer x:Name="helpScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="helpEntriesPanel" Orientation="Vertical" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
