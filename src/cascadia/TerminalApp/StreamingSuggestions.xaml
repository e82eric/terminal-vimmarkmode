<UserControl x:Class="TerminalApp.StreamingSuggestions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:control="using:Microsoft.Terminal.Control"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="300"
             d:DesignWidth="400"
             Background="Black"
             PreviewKeyUp="UserControl_KeyUp"
             PreviewKeyDown="UserControl_KeyDown"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="highlightedNameStyle" TargetType="Run">
                <Setter Property="Foreground" Value="#FF2AAAFF" />
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource FlyoutPresenterBackground}"
        CornerRadius="{ThemeResource OverlayCornerRadius}"
        Shadow="{StaticResource SharedShadow}"
        BorderBrush="#928374"
        BorderThickness="3"
        MaxHeight="250" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBox x:Name="SearchBox" 
                 Grid.Row="0"
                 PlaceholderText="Search..."
                 Margin="8,8,8,4"
                 TextChanged="SearchBox_TextChanged" />
        
        <ListView x:Name="TestListView" 
                  Grid.Row="1"
                  Style="{StaticResource NoAnimationsPlease}"
                  IsItemClickEnabled="True"
                  >
            <ListView.ItemTemplate>

            <DataTemplate x:DataType="local:FuzzyHighlightText">
                <Grid HorizontalAlignment="Stretch"
                      ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <local:HighlightedTextControl Grid.Column="0"
                                                  Grid.Row="0"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Left"
                                                  HighlightedRunStyle="{StaticResource highlightedNameStyle}"
                                                  HighlightedRuns="{x:Bind NameHighlights, Mode=OneWay}"
                                                  Text="{x:Bind NameText, Mode=OneWay}" />

                    <local:HighlightedTextControl Grid.Column="0"
                                                  Grid.Row="1"
                                                  HorizontalAlignment="Left"
                                                  HighlightedRunStyle="{StaticResource highlightedNameStyle}"
                                                  FontStyle="Italic"
                                                  HighlightedRuns="{x:Bind DescriptionHighlights, Mode=OneWay}"
                                                  Text="{x:Bind DescriptionText, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
                
            </ListView.ItemTemplate>

                <ListView.ItemContainerTransitions>
                    <TransitionCollection/>
                </ListView.ItemContainerTransitions>
        </ListView>
    </Grid>
</UserControl>
